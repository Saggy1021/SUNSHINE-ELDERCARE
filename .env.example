# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database
# Connect to your Postgres instance (e.g., Neon or Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/sankalp"

# Authentication
# Generate a secret using: npx auth secret
AUTH_SECRET="dev-secret-replace-in-prod"

# Email Provider Configuration
# Set to 'smtp', 'resend', or 'mock' (for dev)
EMAIL_PROVIDER="mock"
EMAIL_API_KEY="your-email-api-key"
EMAIL_FROM="care@sunshineeldercare.in"
EMAIL_REPLY_TO="care@sunshineeldercare.in"
CONTACT_EMAIL_RECIPIENT="admin@sunshineeldercare.in"
ADMIN_NOTIFICATION_EMAIL="admin@sunshineeldercare.in"
# SMTP Settings (Canonical configuration for Hostinger Production/Staging)
# Note: The application strictly reads SMTP_PASS (aliases like SMTP_PASSWORD or EMAIL_SERVER_PASSWORD are not accepted).
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="care@sunshineeldercare.in"
SMTP_PASS=""
SMTP_SECURE="true"

# Payment Provider Configuration
# Set to 'stripe', 'razorpay', or 'mock' (for dev)
PAYMENT_PROVIDER="mock"
PAYMENT_PUBLIC_KEY="public-key-placeholder"
PAYMENT_SECRET_KEY="secret-key-placeholder"
PAYMENT_WEBHOOK_SECRET="webhook-secret-placeholder"

# Razorpay Production / Staging Gateway Configuration
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Storage Configuration (Phase 19G)
# Provider options: "local", "google-drive", "r2"
STORAGE_PROVIDER="r2"

# Cloudflare R2 Storage Config (Primary Production Provider)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_BUCKET_NAME="sunshine-documents-prod"
R2_PRESIGNED_URL_TTL_SECONDS="900"

# Google Drive Storage Config (Legacy/Temporary Provider)
GOOGLE_DRIVE_FOLDER_ID="1B1krvvoY6Ooh93_uAUirDNrMDTOPVZfK"
GOOGLE_DRIVE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_DRIVE_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_DRIVE_REFRESH_TOKEN="your_google_oauth_refresh_token"

UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=https://thankful-emu-325183.upstash.io
