# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database
# Connect to your Postgres instance (e.g., Neon or Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/sankalp"

# Authentication
# Generate a secret using: npx auth secret
AUTH_SECRET="dev-secret-replace-in-prod"

# Email Provider Configuration
# Set to 'smtp', 'resend', or 'mock' (for dev)
EMAIL_PROVIDER="mock"
EMAIL_API_KEY="your-email-api-key"
EMAIL_FROM="noreply@sankalpeldercare.com"
CONTACT_EMAIL_RECIPIENT="admin@sankalpeldercare.com"
# SMTP Settings (if using SMTP)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Payment Provider Configuration
# Set to 'stripe', 'razorpay', or 'mock' (for dev)
PAYMENT_PROVIDER="mock"
PAYMENT_PUBLIC_KEY="public-key-placeholder"
PAYMENT_SECRET_KEY="secret-key-placeholder"
PAYMENT_WEBHOOK_SECRET="webhook-secret-placeholder"
