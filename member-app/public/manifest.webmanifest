{
  "name": "Sunshine Eldercare Member App",
  "short_name": "Sunshine Care",
  "description": "Official mobile membership portal for Sunshine Eldercare — care tracking, membership overview, receipts, and emergency SOS.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#FAF9F5",
  "theme_color": "#091329",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en-IN",
  "categories": ["medical", "health", "lifestyle"],
  "icons": [
    {
      "src": "/icons/icon-192x192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Member Overview",
      "url": "/dashboard",
      "description": "View active eldercare membership status"
    },
    {
      "name": "Emergency SOS",
      "url": "/dashboard?sos=true",
      "description": "Direct emergency contact and 24/7 care desk"
    },
    {
      "name": "Receipts & Documents",
      "url": "/documents",
      "description": "Download payment receipts and care plans"
    }
  ]
}
