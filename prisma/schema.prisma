// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js Models ---

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String?        @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           String         @default("USER") // USER or ADMIN
  sessionVersion Int            @default(0)
  accounts       Account[]
  sessions       Session[]
  subscriptions  Subscription[]
  orders         Order[]
  invoices       Invoice[]
  elders         Elder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain Models ---

// --- Care Plan Catalog (Source of Truth: Sunshine Elder Care Package) ---

model CarePlan {
  id        String            @id @default(cuid())
  slug      String            @unique // e.g. shield-shine, semi-shield-shine, life-line-care
  name      String // exact name from source document
  active    Boolean           @default(true)
  sortOrder Int               @default(0)
  variants  CarePlanVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CarePlanVariant {
  id               String             @id @default(cuid())
  carePlanId       String
  variantType      String // SINGLE or COUPLE
  monthlyBasePrice Float // exact documented monthly base price (ex-GST)
  monthlyGst       Float // exact documented monthly GST amount
  monthlyTotal     Float // exact documented monthly total
  durations        CarePlanDuration[]
  services         CarePlanService[]
  carePlan         CarePlan           @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  @@unique([carePlanId, variantType])
}

model CarePlanDuration {
  id              String          @id @default(cuid())
  variantId       String
  months          Int // 1, 3, 6, or 12
  documentedTotal Float // exact total from source document — never recalculated
  hasDiscount     Boolean         @default(false)
  discountNote    String? // e.g. "After 7.5% discount"
  variant         CarePlanVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, months])
}

model CarePlanService {
  id          String          @id @default(cuid())
  variantId   String
  serviceName String // exact service name from source document
  serviceNote String? // e.g. "4 x Out door visit per months (Total 10 Hrs/Month)"
  sortOrder   Int             @default(0)
  variant     CarePlanVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Plan {
  id                String  @id @default(cuid())
  name              String
  slug              String  @unique
  description       String?
  price             Float
  currency          String  @default("INR")
  billingType       String  @default("RECURRING") // RECURRING or ONE_TIME
  billingInterval   String? // MONTHLY, ANNUAL, etc.
  taxClassification String? // e.g., EXEMPT, STANDARD_GST
  active            Boolean @default(true)
  metadata          Json?

  addOns        PlanAddOn[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AddOn {
  id                String  @id @default(cuid())
  name              String
  description       String?
  price             Float
  pricingType       String  @default("RECURRING") // RECURRING or ONE_TIME
  taxClassification String?
  active            Boolean @default(true)

  plans PlanAddOn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanAddOn {
  id      String @id @default(cuid())
  planId  String
  addOnId String

  plan  Plan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  addOn AddOn @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@unique([planId, addOnId])
}

model TaxRule {
  id             String    @id @default(cuid())
  taxCode        String    @unique // e.g., STANDARD_GST_18
  taxName        String
  rate           Float // e.g., 18.0
  taxType        String // e.g., GST
  applicability  String // e.g., ALL, INTRA_STATE, INTER_STATE
  active         Boolean   @default(true)
  effectiveFrom  DateTime?
  effectiveUntil DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Elder {
  id           String    @id @default(cuid())
  userId       String // The Customer/Payer
  firstName    String
  lastName     String
  dateOfBirth  DateTime?
  gender       String?
  medicalNotes String?   @db.Text
  address      String?   @db.Text
  city         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CareAssessment {
  id               String  @id @default(cuid())
  customerName     String
  customerPhone    String
  customerEmail    String
  elderName        String?
  city             String?
  requirements     String  @db.Text
  preferredService String?
  urgency          String?
  notes            String? @db.Text
  status           String  @default("NEW") // NEW, REVIEWING, QUOTED, CLOSED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String  @id @default(cuid())
  invoiceNumber String  @unique
  userId        String
  planId        String?

  subtotal  Decimal?
  taxAmount Decimal?
  total     Decimal
  currency  String   @default("INR")

  status        String @default("DRAFT") // DRAFT, ISSUED, PAID, VOID
  paymentStatus String @default("UNPAID") // UNPAID, PAID, FAILED

  issueDate DateTime  @default(now())
  dueDate   DateTime?
  paidDate  DateTime?

  paymentReference String?
  idempotencyKey   String? @unique

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  lineItems InvoiceLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceLineItem {
  id        String @id @default(cuid())
  invoiceId String

  description String

  // Immutable commercial snapshot
  planName       String?
  variantType    String?
  durationMonths Int?
  discountNote   String?

  quantity          Int      @default(1)
  unitPrice         Decimal
  discount          Decimal  @default(0)
  taxClassification String?
  taxRateApplied    Decimal  @default(0)
  taxAmount         Decimal?
  lineTotal         Decimal

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  planId           String
  status           String    @default("PENDING") // PENDING, ACTIVE, CANCELLED
  providerSubId    String?   @unique // Provider-independent external reference
  currentPeriodEnd DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String  @id @default(cuid())
  userId          String
  amount          Float
  status          String  @default("PENDING") // PENDING, SUCCESS, FAILED
  providerOrderId String? @unique // Provider-independent external reference

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inquiry {
  id       String  @id @default(cuid())
  fullName String
  phone    String
  email    String
  city     String?
  message  String  @db.Text
  status   String  @default("NEW") // NEW, IN_PROGRESS, RESOLVED

  createdAt DateTime @default(now())
}
