// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js Models ---

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String?        @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           String         @default("USER") // USER or ADMIN
  sessionVersion Int            @default(0)
  accounts       Account[]
  sessions       Session[]
  subscriptions  Subscription[]
  orders         Order[]
  invoices       Invoice[]
  elders         Elder[]
  emergencyContact EmergencyContact?
  feedback       Feedback[]
  renewalRequests RenewalRequest[]
  payments       Payment[]
  verifiedPayments Payment[] @relation("PaymentVerifiedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs      AuditLog[]
  memberProfile  MemberProfile?
  employee       Employee?
  userRoles      UserRole[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain Models ---

// --- Care Plan Catalog (Source of Truth: Sunshine Elder Care Package) ---

model CarePlan {
  id        String            @id @default(cuid())
  slug      String            @unique // e.g. shield-shine, semi-shield-shine, life-line-care
  name      String // exact name from source document
  active    Boolean           @default(true)
  sortOrder Int               @default(0)
  variants  CarePlanVariant[]
  subscriptions Subscription[]
  renewalRequests RenewalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CarePlanVariant {
  id               String             @id @default(cuid())
  carePlanId       String
  variantType      String // SINGLE or COUPLE
  monthlyBasePrice Float // exact documented monthly base price (ex-GST)
  monthlyGst       Float // exact documented monthly GST amount
  monthlyTotal     Float // exact documented monthly total
  durations        CarePlanDuration[]
  services         CarePlanService[]
  carePlan         CarePlan           @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  @@unique([carePlanId, variantType])
}

model CarePlanDuration {
  id              String          @id @default(cuid())
  variantId       String
  months          Int // 1, 3, 6, or 12
  documentedTotal Float // exact total from source document — never recalculated
  hasDiscount     Boolean         @default(false)
  discountNote    String? // e.g. "After 7.5% discount"
  variant         CarePlanVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, months])
}

model CarePlanService {
  id          String          @id @default(cuid())
  variantId   String
  serviceName String // exact service name from source document
  serviceNote String? // e.g. "4 x Out door visit per months (Total 10 Hrs/Month)"
  sortOrder   Int             @default(0)
  variant     CarePlanVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Plan {
  id                String  @id @default(cuid())
  name              String
  slug              String  @unique
  description       String?
  price             Float
  currency          String  @default("INR")
  billingType       String  @default("RECURRING") // RECURRING or ONE_TIME
  billingInterval   String? // MONTHLY, ANNUAL, etc.
  taxClassification String? // e.g., EXEMPT, STANDARD_GST
  active            Boolean @default(true)
  metadata          Json?

  addOns        PlanAddOn[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AddOn {
  id                String  @id @default(cuid())
  name              String
  description       String?
  price             Float
  pricingType       String  @default("RECURRING") // RECURRING or ONE_TIME
  taxClassification String?
  active            Boolean @default(true)

  plans PlanAddOn[]
  subscriptionAddOns SubscriptionAddOn[]
  renewalRequestAddOns RenewalRequestAddOn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanAddOn {
  id      String @id @default(cuid())
  planId  String
  addOnId String

  plan  Plan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  addOn AddOn @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@unique([planId, addOnId])
}

model TaxRule {
  id             String    @id @default(cuid())
  taxCode        String    @unique // e.g., STANDARD_GST_18
  taxName        String
  rate           Float // e.g., 18.0
  taxType        String // e.g., GST
  applicability  String // e.g., ALL, INTRA_STATE, INTER_STATE
  active         Boolean   @default(true)
  effectiveFrom  DateTime?
  effectiveUntil DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Elder {
  id           String    @id @default(cuid())
  userId       String // The Customer/Payer
  firstName    String
  lastName     String
  dateOfBirth  DateTime?
  gender       String?
  medicalNotes String?   @db.Text
  address      String?   @db.Text
  city         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CareAssessment {
  id               String  @id @default(cuid())
  customerName     String
  customerPhone    String
  customerEmail    String
  elderName        String?
  city             String?
  requirements     String  @db.Text
  preferredService String?
  urgency          String?
  notes            String? @db.Text
  status           String  @default("NEW") // NEW, REVIEWING, QUOTED, CLOSED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String  @id @default(cuid())
  invoiceNumber String  @unique
  userId        String
  planId        String?

  subtotal  Decimal?
  taxAmount Decimal?
  total     Decimal
  currency  String   @default("INR")

  status        String @default("DRAFT") // DRAFT, ISSUED, PAID, VOID
  paymentStatus String @default("UNPAID") // UNPAID, PAID, FAILED

  issueDate DateTime  @default(now())
  dueDate   DateTime?
  paidDate  DateTime?

  paymentReference String?
  idempotencyKey   String? @unique

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  lineItems InvoiceLineItem[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceLineItem {
  id        String @id @default(cuid())
  invoiceId String

  description String

  // Immutable commercial snapshot
  planName       String?
  variantType    String?
  durationMonths Int?
  discountNote   String?

  quantity          Int      @default(1)
  unitPrice         Decimal
  discount          Decimal  @default(0)
  taxClassification String?
  taxRateApplied    Decimal  @default(0)
  taxAmount         Decimal?
  lineTotal         Decimal

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  planId           String?
  carePlanId       String?
  variantType      String?
  durationMonths   Int?
  startDate        DateTime?
  endDate          DateTime?
  
  status           String    @default("PENDING") // PENDING, APPROVED, SCHEDULED, ACTIVE, EXPIRING, EXPIRED, SUSPENDED, CANCELLED
  providerSubId    String?   @unique // Provider-independent external reference
  currentPeriodEnd DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id], onDelete: Restrict)
  carePlan CarePlan? @relation(fields: [carePlanId], references: [id], onDelete: Restrict)

  addOns           SubscriptionAddOn[]
  renewalRequests  RenewalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionAddOn {
  id             String       @id @default(cuid())
  subscriptionId String
  addOnId        String
  
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addOn          AddOn        @relation(fields: [addOnId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
}

model RenewalRequest {
  id                    String   @id @default(cuid())
  userId                String
  currentSubscriptionId String?
  carePlanId            String
  variantType           String
  durationMonths        Int
  requestedStartDate    DateTime
  calculatedEndDate     DateTime
  status                String   @default("SUBMITTED") // SUBMITTED, PENDING_PAYMENT, APPROVED, REJECTED, CANCELLED

  // Immutable commercial snapshot
  planName              String
  documentedTotal       Decimal

  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentSubscription Subscription? @relation(fields: [currentSubscriptionId], references: [id], onDelete: SetNull)
  carePlan            CarePlan      @relation(fields: [carePlanId], references: [id], onDelete: Restrict)

  addOns RenewalRequestAddOn[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RenewalRequestAddOn {
  id               String         @id @default(cuid())
  renewalRequestId String
  addOnId          String
  
  renewalRequest   RenewalRequest @relation(fields: [renewalRequestId], references: [id], onDelete: Cascade)
  addOn            AddOn          @relation(fields: [addOnId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
}

model EmergencyContact {
  id             String  @id @default(cuid())
  userId         String  @unique
  fullName       String
  relationship   String
  phone          String
  alternatePhone String?
  email          String?
  address        String? @db.Text
  notes          String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id       String @id @default(cuid())
  userId   String
  category String
  rating   Int
  message  String @db.Text
  status   String @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, RESPONDED, RESOLVED

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String  @id @default(cuid())
  userId          String
  amount          Float
  status          String  @default("PENDING") // PENDING, SUCCESS, FAILED
  providerOrderId String? @unique // Provider-independent external reference

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inquiry {
  id       String  @id @default(cuid())
  fullName String
  phone    String
  email    String
  city     String?
  message  String  @db.Text
  status   String  @default("NEW") // NEW, IN_PROGRESS, RESOLVED

  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  
  createdAt   DateTime @default(now())
}

model Payment {
  id               String          @id @default(cuid())
  userId           String
  invoiceId        String?
  renewalRequestId String?
  amount           Decimal
  currency         String          @default("INR")
  paymentMethod    String          // "OFFLINE", "MOCK_ONLINE"
  status           String          @default("PENDING") // PENDING, VERIFICATION_PENDING, VERIFIED, REJECTED, CANCELLED
  provider         String          @default("SYSTEM")
  providerRef      String?         @unique
  reference        String?         
  notes            String?         @db.Text
  verifiedAt       DateTime?
  verifiedById     String?
  metadata         Json?
  
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  renewalRequest RenewalRequest? @relation(fields: [renewalRequestId], references: [id], onDelete: SetNull)
  verifiedBy     User?           @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailNotification {
  id              String   @id @default(cuid())
  eventType       String
  entityType      String
  entityId        String
  recipientEmail  String
  idempotencyKey  String
  status          String   @default("PENDING")
  attemptCount    Int      @default(0)
  lastAttemptAt   DateTime?
  sentAt          DateTime?
  failedAt        DateTime?
  error           String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([idempotencyKey, recipientEmail])
  @@index([entityType, entityId])
  @@index([status])
}

model MemberProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  memberId             String?  @unique // Business Member ID (e.g. SEC/S/1001/SAKR)
  
  // Section A: Member Details
  firstName            String
  lastName             String
  idProofType          String?  // e.g., Aadhar, PAN, Voter ID
  idProofNumber        String?  // Sensitive
  dateOfBirth          DateTime?
  gender               String?  // "Male", "Female", "Other"
  serviceAddress       String?  @db.Text
  nearestLandmark      String?
  mobileNumber         String?
  alternateNumber      String?
  email                String?

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  sponsor              Sponsor?
  insuranceDetails     InsuranceDetails?
  medicalAuth          MedicalAuthorization?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Sponsor {
  id                   String   @id @default(cuid())
  memberProfileId      String   @unique
  fullName             String
  relationship         String
  mobileNumber         String
  alternateNumber      String?
  email                String?

  memberProfile        MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model InsuranceDetails {
  id                   String   @id @default(cuid())
  memberProfileId      String   @unique
  providerName         String
  policyNumber         String   // Sensitive
  coverageAmount       String?

  memberProfile        MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model MedicalAuthorization {
  id                   String   @id @default(cuid())
  memberProfileId      String   @unique
  hospitalForSos       String?
  nomineeLocalContact  String?
  shiftAuthorization   Boolean  @default(false)

  memberProfile        MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model MemberSequence {
  id      String @id @default("MEMBER_SEQ")
  current Int    @default(1001)
}

model Employee {
  id              String   @id @default(cuid())
  employeeId      String   @unique // e.g. SEC/101/SAKA
  firstName       String
  lastName        String
  photoReference  String?  @db.Text
  designation     String
  contactNumber   String?
  email           String?
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE
  
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EmployeeSequence {
  id      String @id @default("EMP_SEQ")
  current Int    @default(100)
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., MEMBER_VIEW, PAYMENT_VERIFY
  description String?
  roles       RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Member Manager"
  description String?
  
  permissions RolePermission[]
  users       UserRole[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

